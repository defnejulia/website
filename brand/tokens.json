{
  "brand": "D.AGENCY",
  "source": "D.AGENCY Brand Bible, June 2025",
  "tagline": "Bold ideas, real results – always on trend.",
  "colors": {
    "spicyOrange": { "hex": "#f82303", "rgb": [248, 35, 3],   "cmyk": [0, 92, 100, 0],  "role": "primary" },
    "sandyBeige":  { "hex": "#eeeae1", "rgb": [238, 234, 225], "cmyk": [8, 7, 13, 0],    "role": "background" },
    "azureBlue":   { "hex": "#1a4999", "rgb": [26, 73, 153],   "cmyk": [97, 75, 1, 0],   "role": "accent" },
    "babyPink":    { "hex": "#ffb2c2", "rgb": [255, 178, 194], "cmyk": [0, 36, 10, 0],   "role": "accent-soft" },
    "littleRed":   { "hex": "#890033", "rgb": [137, 0, 51],    "cmyk": [37, 100, 66, 35],"role": "accent-deep" }
  },
  "fonts": {
    "display":  { "family": "Anton",           "weights": [400], "use": "very expressive headlines" },
    "heading":  { "family": "Hanken Grotesk",  "weights": [700], "use": "headlines / sublines" },
    "body":     { "family": "Hanken Grotesk",  "weights": [400], "use": "flowing body text" },
    "accent":   { "family": "Qwitcher Grypen", "weights": [400], "use": "small handwritten accents" }
  },
  "designElements": {
    "spark": { "name": "The Spark", "shape": "4-point sparkle", "assets": "brand/elements/spark*.svg", "uses": ["bullet points", "decorative glow", "accent"] },
    "arrow": { "glyph": "->", "uses": ["links", "CTAs", "next affordance"] },
    "ctaBadges": { "examples": ["NEW", "REEL", "GIVEAWAY", "BOOK NOW!"], "style": "uppercase heavy-weight pill in Spicy Orange" }
  },
  "logos": {
    "logo01": { "name": "Compact with Text", "use": "tight spaces or standalone mark" },
    "logo02": { "name": "Compact with Text", "use": "small or square spaces" },
    "logo03": { "name": "Text Logo",         "use": "clean horizontal surfaces" },
    "assets": {
      "compactOrangePng": "brand/logos/dagency-compact-orange.png",
      "compactPinkPng":   "brand/logos/dagency-compact-pink.png",
      "source":           "brand/logos/source/"
    }
  }
}
